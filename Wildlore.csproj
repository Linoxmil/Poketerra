<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="..\tModLoader.targets" />
    <PropertyGroup>
        <AssemblyName>Wildlore</AssemblyName>
        <LangVersion>latest</LangVersion>
        <OutputType>Exe</OutputType>
        <Nullable>disable</Nullable>
    </PropertyGroup>

    <!--
        No <Using Include="..." /> items here on purpose.

        Global usings are generated by an MSBuild target, and tModLoader's in-game build
        (Workshop -> Develop Mods -> Build + Reload) compiles the .cs files directly with
        Roslyn without running MSBuild. Anything declared here is therefore invisible to the
        only build that ships the mod, and every type in every file comes back unresolved.

        Every namespace is imported explicitly at the top of each file instead, so the
        in-game build and an IDE build see exactly the same sources.
    -->
</Project>
